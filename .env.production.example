APP_URL=https://client.example.com
# Generate once with: openssl rand -base64 32, then prefix the value with base64:
APP_KEY=
DB_PASSWORD=
HUB_BASE_URL=https://hub.example.com
# Set the same generated secret (at least 32 bytes) on Hub and Client.
HUB_PROVISIONING_SECRET=
HTTP_BIND=127.0.0.1
HTTP_PORT=9080
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
# Set the actual reverse proxy addresses on your infrastructure.
TRUSTED_PROXIES=127.0.0.1,::1
